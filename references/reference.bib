}

@article{yuEffectsRainShelter2017,
  title = {Effects of {{Rain}}-shelter {{Cultivation}} on the {{Temporal Dynamics}} of {{Grape Downy Mildew Epidemics}}},
  author = {Yu, Shuyi and Liu, Changyuan and Liang, Chunhao and Zang, Chaoqun and Liu, Li and Wang, Hui and Guan, Tianshu},
