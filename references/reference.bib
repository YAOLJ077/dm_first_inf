@article{rossiEstimatingGerminationDynamics2008,
  title = {Estimating the Germination Dynamics of {{{\emph{Plasmopara}}}}{\emph{ Viticola}} Oospores Using Hydro-thermal Time},
  author = {Rossi, Vittorio and Caffi, T. and Bugiani, R. and Spanna, F. and Valle, D. Della},
  year = {2008},
  month = apr,
  journal = {Plant Pathology},
  volume = {57},
  number = {2},
  pages = {216--226},
  issn = {0032-0862, 1365-3059},
  doi = {10.1111/j.1365-3059.2007.01738.x},
  urldate = {2023-10-22},
  abstract = {The effects of environmental conditions on the variability in germination dynamics of Plasmopara viticola oospores were studied from 1999 to 2003. The germination course was determined indirectly as the relative infection incidence (RII) occurring on grape leaf discs kept in contact with oospores sampled from a vineyard between March and July. The time elapsed between 1 January and the infection occurrence was expressed as physiological time, using four methods: (i) sums of daily temperatures {$>$} 8{$^\circ$}C; (ii) hourly temperatures {$>$} 10{$^\circ$}C; (iii) sums of hourly rates from a temperature-dependent function; or (iv) sums of these rates in hours with a rain or vapour pressure deficit {$\leq$} 4{$\cdot$}5 hPa (hydro-thermal time, HT). An equation of Gompertz in the form RII = exp[-a {$\cdot$} exp(-b {$\cdot$} HT)] produced an accurate fit for both separate years (R2 = 0{$\cdot$}97 to 0{$\cdot$}99) and pooled data (R2 = 0{$\cdot$}89), as well as a good accuracy in cross-estimating new data (r between observed and cross-estimated data were between 0{$\cdot$}93 and 0{$\cdot$}99, P {$<$} 0{$\cdot$}0001). It also accounted for a great part of the variability in oospore germination between years and both between and within sampling periods. Therefore, the equation of Gompertz (with a = 15{$\cdot$}9 {\textpm} 2{$\cdot$}63 and b = 0{$\cdot$}653 {\textpm} 0{$\cdot$}034) calculated over hydro-thermal time, a physiological time accounting for the effects of both temperature and moisture, produced a consistent modelling of the general relationships between the germination dynamics of a population of P. viticola oospores and weather conditions. It represents the relative density of the seasonal oospores that should have produced sporangia when they have experienced favourable conditions for germination.},
  langid = {english},
  keywords = {Done,Important},
  annotation = {JCR分区: Q1\\
中科院分区升级版: 农林科学3区\\
影响因子: 2.3\\
5年影响因子: 2.7\\
南农高质量: A\\
TLDR: The equation of Gompertz (with a = 15{$\cdot$}9 {\textpm} 2{$\cdot$}63 and b = 0{$\cdot$}653 {\textpm} 0{$\cdot$}034) calculated over hydro-thermal time, a physiological time accounting for the effects of both temperature and moisture, produced a consistent modelling of the general relationships between the germination dynamics of a population of P. viticola oospores and weather conditions.},
  file = {/Users/yaolinjia/Desktop/NWAFU/Zotero/storage/M3GNSCCF/Rossi 等 - 2008 - Estimating the germination dynamics of Plasmopa.pdf}
}

