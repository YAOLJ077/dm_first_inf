@article{onestiAccuratePredictionBlack2016,
  title = {Accurate Prediction of Black Rot Epidemics in Vineyards Using a Weather-Driven Disease Model: {{Accurate}} Prediction of Black Rot in Vineyards},
  shorttitle = {Accurate Prediction of Black Rot Epidemics in Vineyards Using a Weather-Driven Disease Model},
  author = {Onesti, Giovanni and {Gonz{\'a}lez-Dom{\'i}nguez}, Elisa and Rossi, Vittorio},
  year = {2016},
  month = dec,
  journal = {Pest Management Science},
  volume = {72},
  number = {12},
  pages = {2321--2329},
  issn = {1526498X},
  doi = {10.1002/ps.4277},
  urldate = {2023-10-22},
  abstract = {BACKGROUND: Grapevine black rot caused by Guignardia bidwellii is a serious threat in vineyards, especially in areas with cool and humid springs. A mechanistic, weather-driven model was recently developed for the detailed prediction of black rot epidemics. The aim of this work was to evaluate the model by comparison with observed disease development in leaves and clusters in a vineyard in north Italy from 2013 to 2015. RESULTS: The model accurately predicted disease onset. The probability of predicting new infections that did not occur (i.e. unjustified alarms) was {$\leq$}0.180, while the probability of missing actual infections was 0.175 for leaves and 0.263 for clusters. In 78\% of these false negative predictions, the difference between expected and actual disease onset was {\textpm}2 days; therefore, only one infection period was actually missed by the model. The model slightly overestimated disease severity (mainly on leaves) when the observed disease severity was {$>$}0.6. CONCLUSION: The model was highly accurate and robust in predicting the infection periods and dynamics of black rot epidemics. The model can be used for scheduling fungicide sprays in vineyards. {\copyright} 2016 Society of Chemical Industry},
  langid = {english},
  annotation = {JCR分区: Q1\\
中科院分区升级版: 农林科学1区\\
影响因子: 3.8\\
5年影响因子: 4.3\\
南农高质量: A\\
TLDR: The mechanistic, weather-driven model was highly accurate and robust in predicting the infection periods and dynamics of black rot epidemics and can be used for scheduling fungicide sprays in vineyards.},
  file = {/Users/yaolinjia/Desktop/NWAFU/Zotero/storage/D6E2B4R4/Onesti 等 - 2016 - Accurate prediction of black rot epidemics in vine.pdf}
}

@article{orlandiniAgrometeorologicalApproachSimulation2008,
  title = {An Agrometeorological Approach for the Simulation of {{Plasmopara}} Viticola},
  author = {Orlandini, S. and Massetti, L. and Marta, A. Dalla},
  year = {2008},
  month = dec,
  journal = {Computers and Electronics in Agriculture},
  volume = {64},
  number = {2},
  pages = {149--161},
  issn = {01681699},
  doi = {10.1016/j.compag.2008.04.004},
  urldate = {2023-10-22},
  abstract = {Agrometeorology can be applied to the analysis and modelling of plant disease development and creating a decision-support system for the operational management of crop protection. An approach for the simulation of grapevine (Vitis vinifera) downy mildew (Plasmopara viticola) is described in this paper. Mathematical models for grapevine leaf area growth and downy mildew development and infection have been proposed and integrated. The inputs to the models are represented by the fundamental agrometeorological variables of air temperature ({\textopenbullet}C), relative humidity (\%), rainfall (mm) and leaf wetness (0--1), and tuning parameters have been included to calibrate the models for any possible behaviour differences in the patho-system. The main outputs of the model are infection intensity during the growing season, and the timing of the different infection events. The research was conducted in Tuscany (Central Italy) where, since 1995, an experimental vineyard of Sangiovese variety has been monitored for the presence of the disease, and a standard station has been established for agrometeorological data collection. The model was calibrated on data collected in 1995 and 1996 and then applied and validated on an independent data set collected from 1998 to 2003. The results presented in this paper demonstrate how, based on the biology of both host and pathogen, the simulation calculated leaf area growth and the dynamics of disease infections during the season, giving an accurate description of the field situation.},
  langid = {english},
  annotation = {JCR分区: Q1\\
中科院分区升级版: 农林科学1区\\
影响因子: 7.7\\
5年影响因子: 8.4\\
EI: 是\\
南农高质量: A},
  file = {/Users/yaolinjia/Desktop/NWAFU/Zotero/storage/IG37GH9G/Orlandini 等 - 2008 - An agrometeorological approach for the simulation .pdf}
}

