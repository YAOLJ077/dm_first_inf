@article{thinesRecentOutbreaksDowny2011,
  title = {Recent Outbreaks of Downy Mildew on Grape Ivy ({{Parthenocissus}} Tricuspidata, {{Vitaceae}}) in {{Germany}} Are Caused by a New Species of {{Plasmopara}}},
