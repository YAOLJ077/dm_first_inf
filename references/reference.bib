  urldate = {2025-08-16},
  abstract = {Grapevine trunk diseases (GTDs) are serious threats worldwide and are difficult to control, in part because the environmental requirements for epidemiological processes of the causal fungi are poorly understood. Therefore, we investigated the effects of temperature and moisture duration on spore germination of four fungi associated with two GTDs (esca complex and Eutypa dieback): Phaeomoniella chlamydospora, Phaeoacremonium minimum, Cadophora luteo-olivacea, and Eutypa lata. Conidia of Phaeomoniella chlamydospora, Phaeoacremonium minimum, and C. luteo-olivacea were similar: conidia of these fungi germinated profusely ({$>$}90\%) between 20 and 30{$^\circ$}C; Phaeomoniella chlamydospora and Phaeoacremonium minimum tended to germinate at higher temperatures (up to 40{$^\circ$}C for P. minimum), and C. luteo-olivacea at lower temperatures (as low as 5{$^\circ$}C). E. lata ascospores germinated between 10 and 30{$^\circ$}C. The required duration of moist periods for germination was shortest for C. luteo-olivacea (about 6 h), followed by P. minimum and E. lata (about 12 h) and Phaeomoniella chlamydospora (about 24 h). Further research on the environmental requirements of GTD fungi may increase our ability to predict infection periods and, thereby, improve disease control.},
  langid = {english},
  annotation = {TLDR: The effects of temperature and moisture duration on spore germination of four fungi associated with two GTDs, including Esca complex and Eutypa dieback, are investigated to increase the ability to predict infection periods and to thereby improve disease control.},
  file = {/Users/yaolinjia/Desktop/NWAFU/Zotero/storage/ASWX9BEC/Ji 等 - 2023 - Effects of temperature and moisture duration on spore germination of four fungi that cause grapevine.pdf}
}

@misc{jiLayeredStomatalImmunity2025,
  title = {Layered Stomatal Immunity Contributes to Resistance of {\emph{Vitis Riparia}} against Downy Mildew {\emph{Plasmopara Viticola}}},
  author = {Ji, Wei and Zheng, Wei and Mei, JunJie and Liu, Xiaoyu and {Abe-Kanoh}, Naomi and Rhaman, Mohammad Saidur and Qin, Guochen and Ye, Wenxiu},
  year = {2025},
  month = feb,
  publisher = {Plant Biology},
  doi = {10.1101/2025.02.23.639706},
  urldate = {2025-03-25},
  abstract = {ABSTRACT                        Downy mildew (DM), caused by             Plasmopara viticola             , is one of the most serious grapevine diseases. Resistant grapevines are a well-known tool for mitigating pathogen-caused damage. We evaluated 29 global grapevine cultivars from 7 species for the sensitivity to             P. viticola             . Chardonnay belonging to the sensitive species             V. vinifera             and Qingdahean belonging to the well-known resistant species             V. riparia             were chosen for further investigation on the resistance mechanism against DM. Unlike Chardonnay, Qingdahean exerted an inhibitory effect on stomatal targeting, suppression of stomatal closure, stomatal penetration of             P. viticola             , and the development of primary hyphae and haustoria during the early phase of infection, and contained higher levels of malondialdehyde (MDA), which was significantly increased by             P. viticola             infection, toxic to the pathogen and had an interfering effect on the stomatal targeting. Furthermore, Qingdahean resisted pathogen invasion through the rapid induction of guard cell death and the hypersensitive responses (HR) of other cell types. These findings suggest that resistance to             P. viticola             consists of layered stomatal immunity in addition to the well-known HR in             V. riparia             , which is overcome by the pathogen in             V. vinifera             .},
  archiveprefix = {Plant Biology},
  copyright = {http://creativecommons.org/licenses/by-nc-nd/4.0/},
  langid = {english},
  file = {/Users/yaolinjia/Desktop/NWAFU/Zotero/storage/2W9549UV/Ji 等 - 2025 - Layered stomatal immunity contributes to resistance of vitis riparia against downy mildew .pdf}
}

