@article{shenHyperparasitismPlasmoparaViticola2022,
  title = {Hyperparasitism on {{{\emph{Plasmopara}}}}{\emph{ Viticola}} by {{{\emph{Simplicillium}}}}{\emph{ Lanosoniveum}}},
  author = {Shen, Hongmiao and Shi, Xiaomeng and Ran, Longxian},
