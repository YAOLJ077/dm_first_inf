@article{fedeleSystematicMapResearch2022,
  title = {A {{Systematic Map}} of the {{Research}} on {{Disease Modelling}} for {{Agricultural Crops Worldwide}}},
  author = {Fedele, Giorgia and Brischetto, Chiara and Rossi, Vittorio and {Gonzalez-Dominguez}, Elisa},
  year = {2022},
  month = mar,
  journal = {Plants},
  volume = {11},
  number = {6},
  pages = {724},
  issn = {2223-7747},
  doi = {10.3390/plants11060724},
  urldate = {2023-10-22},
  abstract = {In this work, we developed a systematic map to identify and catalogue the literature pertaining to disease modelling for agricultural crops worldwide. Searches were performed in 2021 in the Web of Science and Scopus for papers reporting any type of disease model for 103 crops. In total, 768 papers were retrieved, and their descriptive metadata were extracted. The number of papers found increased from the mid-1900s to 2020, and most of the studies were from North America and Europe. More disease models were retrieved for wheat, potatoes, grapes, and apples than for other crops; the number of papers was more affected by the crop's economic value than by its cultivated area. The systematic map revealed an underrepresentation of disease models for maize and rice, which is not justified by either the crop economic value or by disease impact. Most of the models were developed to understand the pathosystem, and fewer were developed for tactical disease management, strategic planning, or scenario analysis. The systematic map highlights a variety of knowledge gaps and suggests questions that warrant further research.},
  langid = {english},
  file = {/Users/yaolinjia/Desktop/NWAFU/Zotero/storage/CXRA6HEH/Fedele 等 - 2022 - A Systematic Map of the Research on Disease Modell.pdf}
}

