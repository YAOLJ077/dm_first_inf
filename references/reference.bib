@article{acunaGlobalAssessmentState2023,
  title = {A Global Assessment of the State of Plant Health},
  author = {Acu{\~n}a, Ivette and {Andrade-Piedra}, Jorge and Andrivon, Didier and Armengol, Josep and Elizabeth Arnold, A. and Avelino, Jacques and Bandyopadhyay, Ranajit and Bihon Legesse, Wubetu and Bock, Clive H. and Bove, Federica and {Brenes-Arguedas}, Tania and Calonnec, Agn{\`e}s and Carmona, Marcelo and Carnegie, Angus J. and Castilla, Nancy P. and Chen, Xianming and {Coletta-Filho}, Helvecio Della and Coley, Phyllis D. and Cox, Kerik D. and Davey, Triona and Del Ponte, Emerson and Denman, Sandra and {Desprez-Loustau}, Marie-Laure and Dewdney, Megan M. and Djurle, Annika and Drenth, Andr{\'e} and Ducousso, Alexis and Esker, Paul and Fiaboe, Komi M. and Hendrik Fourie, Paul and Frankel, Susan J. and Frey, Pascal and {Garcia-Figuera}, Sara and Garrett, Karen A. and Gu{\'e}rin, Maxime and Hardy, Giles E. St. J. and Hausladen, Hans and Hu, Xiaoping and H{\"u}berli, Daniel and Juzwik, Jennifer and Kang, Zhensheng and Kenyon, Lawrence and Kreuze, Jan and Kromann, Peter and Kubiriba, Jerome and Kuhnem, Paulo and Kumar, J. and Lava Kumar, P. and Lebrun, Marc-Henri and Legg, James P. and Leon, Anna and Ma, Zhanhong and Mahuku, George and Makinson, Robert O. and Marzachi, Cristina and McDonald, Bruce A. and McRoberts, Neil and Menkir, Abebe and Mikaberidze, Alexey and Munck, Isabel A. and Nelson, Andrew and Nguyen, Nga Thi Thu and O'Gara, Emer and Ojiambo, Peter and {Ortega-Beltran}, Alejandro and Paul, Pierce and Pethybridge, Sarah and Pinon, Jean and Ramsfield, Tod and Rizzo, David M. and Rossi, Vittorio and Safni, Irda and Sah, Sonam and Santini, Alberto and Sautua, Francisco and Savary, Serge and Schreinemachers, Pepijn and Singh, Manjari and Spear, Erin R. and Srinivasan, Ramasamy and Tripathi, Leena and Vicent, Antonio and Viljoen, Altus and Willocquet, Laetitia and Woods, Alex John and Wu, Boming and Xia, Xianchun and Xu, Xiangming and Yuen, Jonathan and Zalamea, Paul-Camilo and Zhou, Changyong},
  year = {2023},
  month = dec,
  journal = {Plant Disease},
  volume = {107},
  number = {12},
  pages = {3649--3665},
  issn = {0191-2917, 1943-7692},
  doi = {10.1094/PDIS-01-23-0166-FE},
  urldate = {2025-08-16},
  abstract = {The Global Plant Health Assessment (GPHA) is a collective, volunteerbased effort to assemble expert opinions on plant health and disease impacts on ecosystem services based on published scientific evidence. The GPHA considers a range of forest, agricultural, and urban systems worldwide. These are referred to as (Ecoregion {\texttimes} Plant System), i.e., selected case examples involving keystone plants in given parts of the world. The GPHA focuses on infectious plant diseases and plant pathogens, but encompasses the abiotic (e.g., temperature, drought, and floods) and other biotic (e.g., animal pests and humans) factors associated with plant health. Among the 33 (Ecoregion {\texttimes} Plant System) considered, 18 are assessed as in fair or poor health, and 20 as in declining health. Much of the observed state of plant health and its trends are driven by a combination of forces, including climate change, species invasions, and human management. Healthy plants ensure (i) provisioning (food, fiber, and material), (ii) regulation (climate, atmosphere, water, and soils), and (iii) cultural (recreation, inspiration, and spiritual) ecosystem services. All these roles that plants play are threatened by plant diseases. Nearly none of these three ecosystem services are assessed as improving. Results indicate that the poor state of plant health in sub-Saharan Africa gravely contributes to food insecurity and environmental degradation. Results further call for the need to improve crop health to ensure food security in the most populated parts of the world, such as in South Asia, where the poorest of the poor, the landless farmers, are at the greatest risk. The overview of results generated from this work identifies directions for future research to be championed by a new generation of scientists and revived public extension services. Breakthroughs from science are needed to (i) gather more data on plant health and its consequences, (ii) identify collective actions to manage plant systems, (iii) exploit the phytobiome diversity in breeding programs, (iv) breed for plant genotypes with resilience to biotic and abiotic stresses, and (v) design and implement plant systems involving the diversity required to ensure their adaptation to current and growing challenges, including climate change and pathogen invasions.},
  langid = {english},
  file = {/Users/yaolinjia/Desktop/NWAFU/Zotero/storage/5C3XT3EI/Acuña 等 - 2023 - A global assessment of the state of plant health.pdf}
}

