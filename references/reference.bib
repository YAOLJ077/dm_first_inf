  abstract = {Grapevine downy mildew, incited by the oomycete Plasmopara viticola, is an important pernicious pathogen that threatens grapevine cultivation. To facilitate early detection and quantification, this study employed SYBR Green-based quantitative Polymerase Chain Reaction (qPCR) targeting the cellulase synthase A4 gene of P. viticola. Under in-vitro study, the pathogen was detected 4 days prior to symptom development on artificially inoculated grapevine leaves with a sporangial suspension of 1 {\texttimes} 104 sporangia/ml. To quantify the airborne inoculum, a standard curve was generated using tenfold dilutions (105 to 101 sporangia/ml) placed on sampling rods. On the basis of the qPCR results, a minimum inoculum threshold of 100 sporangia (Cq value = 23.98 {\textpm} 0.7) was considered for the detection of field samples. Airborne inocula of P. viticola were detected from the spore traps installed at heights of 0.5 m and 2.5 m from pruning to harvest and quantified using qPCR. A sampling rod collected from a height of 0.5 m was used to detect the pathogen from pruning to fruit set, with a maximum concentration of 2.8 {\texttimes} 105 sporangia/m3. The assay detected the inoculum 10--14 days before visual symptom appearance in the field. Therefore, early detection of pathogen inoculum using spore trapping technology coupled with qPCR will be helpful in the development of forewarning the possible occurrence, risk prediction, and the need based fungicidal application.},
  langid = {english},
  file = {/Users/yaolinjia/Desktop/NWAFU/Zotero/storage/5ZWXV9DT/Muthukumar et al. - 2025 - Early detection and quantification of airborne inocula of plasmopara viticola causing grapevine down.pdf}
}

