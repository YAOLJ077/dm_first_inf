@article{laveeDormancyGrapevineBuds1997,
  title = {Dormancy of Grapevine Buds - Facts and Speculation},
  author = {Lavee, S. and May, P.},
  year = {1997},
  month = apr,
  journal = {Australian Journal of Grape and Wine Research},
  volume = {3},
  number = {1},
  pages = {31--46},
  issn = {13227130, 17550238},
  doi = {10.1111/j.1755-0238.1997.tb00114.x},
  urldate = {2023-07-09},
  abstract = {Dormancy of grapevine buds, which is of special concern in warm subtropical and tropical climates, is reviewed. The sequence of the stages of dormancy, from the onset of pre-dormancy to the gradual development of dormancy and to the following release to post-dormancy leading to growth resumption, are described. Relationships are shown between these physiological stages and the effects of correlative inhibition and of environmental factors such as chilling, supra-optimal temperatures and daylength. Known metabolic changes during dormancy, involving the effects of growth substances, thiols, proteins and nucleic acids, and especially of cyanamide, are discussed. It is concluded that more extensive studies using methods of molecular biology are required to make further advances in our understanding of dormancy in grapevine buds.},
  langid = {english},
  file = {F:\YAO_2023\Grape\文献\Phenological\Aust J Grape and Wine Res - 2008 - LAVEE - Dormancy of grapevine buds ‐ facts and speculation.pdf}
}

@article{leglerNonlinearModelTemperaturedependent2012,
  title = {A Nonlinear Model for Temperature-dependent Development of {\emph{Erysiphe Necator}} Chasmothecia on Grapevine Leaves},
  author = {Legler, S. E. and Caffi, T. and Rossi, V.},
  year = {2012},
  month = feb,
  journal = {Plant Pathology},
  volume = {61},
  number = {1},
  pages = {96--105},
  issn = {0032-0862, 1365-3059},
  doi = {10.1111/j.1365-3059.2011.02498.x},
  urldate = {2025-08-16},
  abstract = {Production and development of the chasmothecia of Erysiphe necator on Vitis vinifera leaves were studied using potted plants in controlled and outdoor environments and grapevines in a vineyard. The optimum temperature for ascocarp production was 20{$^\circ$}C; fewer chasmothecia were produced at 15{$^\circ$}C and even fewer at 25{$^\circ$}C; at 10 and 30{$^\circ$}C, no or very few chasmothecia were observed, and none reached maturity. Nonlinear equations describing ascocarp development as a function of time and temperature were developed, parameterized with data from experiments at constant temperatures, and evaluated under fluctuating temperatures. Goodness-of-fit showed high agreement between observed and predicted data: the model efficacy ranged from 0{\AE}74 to 0{\AE}97 (1{\AE}0 indicates a perfect fit), and the root mean square error ranged from 0{\AE}001 to 0{\AE}01 (zero indicates a perfect fit). The high proportion of the observed variability accounted for by these equations (R2 = 0{\AE}83--0{\AE}98) supported the hypothesis that temperature has a predominant role in ascocarp development under natural conditions, when all environmental factors interact. The equations tended to overestimate the production of mature chasmothecia (the coefficient of residual mass was )0{\AE}23), but this inconsistency mainly occurred when rainfall apparently washed the mature chasmothecia from leaves during the logarithmic phase of the ascocarp developmental curve. Results from this work will be useful for predicting the development of chasmothecia in a vineyard and for timing the use of natural products, fungicides or biocontrol agents for reducing the population of chasmothecia, which are all more effective when they are applied to immature chasmothecia.},
  copyright = {http://onlinelibrary.wiley.com/termsAndConditions\#vor},
  langid = {english},
  annotation = {TLDR: Production and development of the chasmothecia of Erysiphe necator on Vitis vinifera leaves were studied using potted plants in controlled and outdoor environments and grapevines in a vineyard to support the hypothesis that temperature has a predominant role in ascocarp development under natural conditions, when all environmental factors interact.},
  file = {/Users/yaolinjia/Desktop/NWAFU/Zotero/storage/4A74Z49R/Legler 等 - 2012 - A nonlinear model for temperature‐dependent development of erysiphe necator chasmothecia on g.pdf}
}

