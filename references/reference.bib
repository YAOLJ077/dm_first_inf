@article{romanazziUseChitosanOther2021,
  title = {Use of {{Chitosan}} and {{Other Natural Compounds Alone}} or in {{Different Strategies}} with {{Copper Hydroxide}} for {{Control}} of {{Grapevine Downy Mildew}}},
  author = {Romanazzi, Gianfranco and Mancini, Valeria and Foglia, Renzo and Marcolini, Diego and Kavari, Mojtaba and Piancatelli, Simone},
  year = {2021},
  month = oct,
  journal = {Plant Disease},
