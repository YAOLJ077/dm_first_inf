@article{rosaceSpatiotemporalDatasetPlant2023,
  title = {A Spatio-Temporal Dataset of Plant Pests' First Introductions across the {{EU}} and Potential Entry Pathways},
  author = {Rosace, Maria Chiara and Cendoya, Martina and Mattion, Giulia and Vicent, Antonio and Battisti, Andrea and Cavaletto, Giacomo and Marini, Lorenzo and Rossi, Vittorio},
  year = {2023},
