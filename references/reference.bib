@article{pengAdvancesUnderstandingGrapevine2024a,
  title = {Advances in Understanding Grapevine Downy Mildew: {{From}} Pathogen Infection to Disease Management},
  shorttitle = {Advances in Understanding Grapevine Downy Mildew},
  author = {Peng, Junbo and Wang, Xuncheng and Wang, Hui and Li, Xinghong and Zhang, Qi and Wang, Meng and Yan, Jiye},
