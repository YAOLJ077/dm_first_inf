@article{rossiEffectWaterGermination2007a,
  title = {Effect of Water on Germination of {{{\emph{Plasmopara}}}}{\emph{ Viticola}} Oospores},
  author = {Rossi, V. and Caffi, T.},
  year = {2007},
  month = dec,
  journal = {Plant Pathology},
  volume = {56},
  number = {6},
  pages = {957--966},
  issn = {0032-0862, 1365-3059},
  doi = {10.1111/j.1365-3059.2007.01685.x},
  urldate = {2024-12-17},
  abstract = {The effect of moisture in grape leaf litter holding overwintering Plasmopara viticola oospores was investigated. Oospores were incubated under different regimes of water activity (aW 0{$\cdot$}991 to 0{$\cdot$}123) for 2 to 15 days and their ability to germinate and cause infection was determined using a sensitive leaf disk assay. Reduction of aW caused a significant shift in the infection dynamics, with maximum effect when aW {$\leq$} 0{$\cdot$}56. Dynamics of aW in the leaf litter under natural conditions were estimated from moisture data using a Chen-Clayton equation. Daily patterns of leaf litter moisture (M in \% weight) were determined in non rainy periods between mid February and mid June, while the Chen-Clayton equation was calculated using data of aW and M measured in both sorption and desorption conditions, at different temperatures. Water activity was highest at 08{$\cdot$}00 hours, decreased progressively until 14{$\cdot$}00 hours, and then increased. Water activity was favourable for oospores to develop in about 25\% of the measurements, all made between 18{$\cdot$}00 hours and 08{$\cdot$}00 hours. A close relationship was found between vapour pressure deficit (VPD in hPa) and aW of the leaf litter, so that when VPD is lower than 2{$\cdot$}13 hPa there is sufficient water for oospores to develop. Results showed that leaf litter moisture due to water from the atmosphere makes oospore development possible during non rainy periods.},
  copyright = {http://onlinelibrary.wiley.com/termsAndConditions\#vor},
  langid = {english},
  annotation = {TLDR: Leaf litter moisture due to water from the atmosphere makes oospore development possible during non rainy periods and a close relationship was found between vapour pressure deficit and aW of the leaf litter, so that when VPD is lower than 2{$\cdot$}13~hPa there is sufficient water for oospores to develop.},
  file = {/Users/yaolinjia/Desktop/NWAFU/Zotero/storage/WMC3AM8Z/Rossi 和 Caffi - 2007 - Effect of water on germination of Plasmopara vi.pdf}
}

