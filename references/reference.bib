  shorttitle = {Plant {{Disease Models}} and {{Forecasting}}},
  author = {{Gonz{\'a}lez-Dom{\'i}nguez}, Elisa and Caffi, Tito and Rossi, Vittorio and Salotti, Irene and Fedele, Giorgia},
