@article{garcia-garciaRiskPredictionLecanosticta2025,
  title = {Risk Prediction of Lecanosticta Acicola Spore Abundance in Atlantic Climate Regions},
  author = {{Garc{\'i}a-Garc{\'i}a}, David and Mesanza, Nebai and Raposo, Rosa and Pascual, Mª Teresa and Barrena, Iskander and Urkola, Amaia and Berano, Nagore and Iturritxa, Eugenia},
  year = {2025},
