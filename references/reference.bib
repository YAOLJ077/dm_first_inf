  author = {Williams, M. G. and Magarey, P. A. and Sivasithamparam, K.},
  year = {2007},
  journal = {Australasian Plant Pathology},
  volume = {36},
  number = {4},
  pages = {325},
  issn = {0815-3191},
  doi = {10.1071/AP07029},
  urldate = {2023-10-22},
  abstract = {Grape downy mildew, caused by Plasmopara viticola, is a relatively new disease in Western Australia (WA). The effect of temperature and light intensity on zoospore germination and penetration of stomatal apertures by a WA isolate of P. viticola in the presence of free water on leaf discs of grapevine (Vitis vinifera) is described. Germination and penetration commenced within the first hour following inoculation. Zoospores germinated at temperatures ranging from 5 to 30{\textopenbullet}C, but not at 35{\textopenbullet}C. Germ tubes penetrated stomatal apertures at temperatures ranging from 10 and 25{\textopenbullet}C, but not at 30 or 35{\textopenbullet}C and rarely at 5{\textopenbullet}C. A 20{\textopenbullet}C dark environment favoured zoospore germination and host penetration, whereas both infection events occurred at a lower frequency in the light. Light exerted an inhibitory effect on the development of zoospores soon after their release from sporangia. This in turn influenced the infectivity of the pathogen.},
  langid = {english},
  keywords = {Done},
  annotation = {JCR分区: Q4\\
