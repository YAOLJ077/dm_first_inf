\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Sobol sensitivity of six FSIM parameters for the censored mean first symptom-onset day across six site--years. (a) First-order (\(S_1\)) and total-order (\(S_T\)) indices at \(N=1024\); (b) total-order indices across \(N=256\), 512, and 1024. Error bars show 95\% bootstrap confidence intervals. Parameter abbreviations: EDR = effective deposition rainfall threshold; SRH = sporulation relative-humidity threshold; MMH = minimum moist-hour threshold; HWR = heavy-rain wash-off threshold; IDH = infection degree-hour threshold; WTH = minimum wind-speed threshold.}}{18}{figure.caption.12}\protected@file@percent }
\newlabel{_Ref222510092}{{9}{18}{Sobol sensitivity of six FSIM parameters for the censored mean first symptom-onset day across six site--years. (a) First-order (\(S_1\)) and total-order (\(S_T\)) indices at \(N=1024\); (b) total-order indices across \(N=256\), 512, and 1024. Error bars show 95\% bootstrap confidence intervals. Parameter abbreviations: EDR = effective deposition rainfall threshold; SRH = sporulation relative-humidity threshold; MMH = minimum moist-hour threshold; HWR = heavy-rain wash-off threshold; IDH = infection degree-hour threshold; WTH = minimum wind-speed threshold}{figure.caption.12}{}}
